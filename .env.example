EMAIL_FROM=TutorApp <your-gmail@gmail.com>

# --- Resend (future, when you have a domain) ---
# RESEND_API_KEY=re_xxxxx
# EMAIL_FROM=TutorApp <notifications@yourdomain.com>
# EMAIL_DOMAIN=yourdomain.com
# NEXT_PUBLIC_EMAIL_DOMAIN=yourdomain.com

